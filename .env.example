# Salin menjadi .env untuk lokal. Jangan commit .env.
# Endpoint tick wajib memakai secret ini.
CRON_SECRET=ganti-dengan-string-acak-panjang

# Storage produksi (Vercel Marketplace -> Upstash Redis, paket gratis).
# Kalau kosong, bot memakai penyimpanan file lokal (hanya untuk laptop).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kill switch manual. Ubah ke 1 di dashboard Vercel lalu redeploy? Tidak perlu redeploy:
# ubah environment variable di Vercel, perubahan berlaku pada invocation berikutnya.
KILL_SWITCH=0

# Modal virtual awal (Rp).
PAPER_EQUITY=100000000

# Dipakai GitHub Actions untuk memanggil endpoint.
TICK_URL=https://contoh.vercel.app/api/tick
